# Copie para .env e preencha. Nada aqui é lido do repositório em produção.

# Postgres do core-service (container local via docker-compose; use suas próprias
# credenciais se apontar para um Postgres externo, ex.: Neon)
DB_USERNAME=smartteca
DB_PASSWORD=smartteca

# LLM do chatbot. Default (sem preencher nada aqui) e Ollama local:
# instale https://ollama.com, rode "ollama pull qwen3:8b" e deixe as 3 linhas
# abaixo comentadas. Pra usar um provedor cloud compativel com OpenAI (Groq,
# Google AI Studio etc.) em vez do Ollama, descomente e preencha:
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# Esforço de raciocínio do modelo (reasoning_effort). "none" é ~4x mais rápido em modelos como o qwen3 no Ollama;
# use low/medium/high para reativar. ATENÇÃO: modelos sem raciocínio (ex.: llama-3.3 no Groq) podem recusar esse
# parâmetro; com eles, remova a linha SPRING_AI_OPENAI_CHAT_OPTIONS_REASONING_EFFORT do docker-compose.yml.
AI_REASONING_EFFORT=none

# Assinatura dos JWT (RS256 — par de chaves, não segredo simétrico).
# Gere com:
#   openssl genrsa -out private_key.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in private_key.pem -out private_key_pkcs8.pem
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# Depois cole o conteúdo de cada arquivo (sem quebra de linha) aqui.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Primeiro bibliotecário (o cadastro de usuários exige um bibliotecário logado). Senha: 8+ caracteres, maiúscula, minúscula e número.
ADMIN_MATRICULA=
ADMIN_SENHA=

# Supabase Storage (capas e PDFs)
SUPABASE_URL=
SUPABASE_KEY=

# Evolution API (WhatsApp)
EVOLUTION_APIKEY=123456
EVOLUTION_DB_PASSWORD=123456

# RabbitMQ (management UI em http://localhost:15672)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# CORS do frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
